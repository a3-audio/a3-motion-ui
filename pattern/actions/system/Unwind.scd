// Unwind -- the same turn, the other way and slower.
//
// Fired after Whirl it reads as the room settling back. The sign is the
// direction; the magnitude is the speed.

~spin = -3;
~reach = 0.6;
~end = \loop;

~attack = 3;
~decay = 5;
~envelopeMax = 0.7;

~freqAttack = 3;
~freqDecay = 5;
~freqMax = 0.45;

~act = \hold;
