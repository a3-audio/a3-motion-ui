// Slam -- the whole clip thrown wide open, and gone again.
//
// The hit for a drop landing. Nothing about it is gradual, so the times are
// the shortest the envelope has and every ceiling is at the top.

~reach = 1.0;
~spin = 6;
~end = \bounce;

~attack = 0;
~decay = 2;
~envelopeMax = 1.0;

~freqAttack = 0;
~freqDecay = 2;
~freqMax = 1.0;
~qAttack = 0;
~qDecay = 1;
~qMax = 0.4;

~act = \oneshot;
