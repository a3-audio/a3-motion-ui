// Stab -- one point, in and out inside a sixteenth.
//
// The opposite of Slam: the sound collapses to a spot instead of filling the
// room, and the resonance carries what little length there is.

~reach = 0.12;
~spin = 0;
~end = \pause;

~attack = 0;
~decay = 0;
~envelopeMax = 0.9;

~freqAttack = 0;
~freqDecay = 0;
~freqMax = 0.7;
~qAttack = 0;
~qDecay = 0;
~qMax = 0.8;

~act = \oneshot;
