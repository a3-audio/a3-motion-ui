// Ground -- the same cap, at the far pole.
//
// Overhead's opposite number, and the pair reads as a jump between two
// places rather than a movement between them.

~base = 1.0;
~reach = 0.3;
~spin = -4;
~end = \loop;

~attack = 1;
~decay = 3;
~envelopeMax = 0.8;

~freqAttack = 2;
~freqDecay = 3;
~freqMax = 0.3;

~act = \oneshot;
