// Sink -- held, the sound goes under the floor.
//
// Rise turned over. The far pole is 1, and a clip parked there reads as
// weight rather than height -- useful under a breakdown that has to feel
// like it is below you.

~base = 1.0;
~reach = 0.45;
~spin = -2;

~attack = 5;
~decay = 4;
~envelopeMax = 0.7;

~freqAttack = 4;
~freqDecay = 5;
~freqMax = 0.35;

~act = \hold;
