// Ring -- a band at ear height, turning.
//
// The base sits at the equator and the clip's top and bottom are cut in
// towards it, which leaves a horizontal ring however tall the recorded
// movement was. The one action that makes any clip sound like the same clip.

~base = 0.5;
~reach = 0.55;
~clipTop = 0.35;
~clipBottom = 0.35;
~spin = 5;
~end = \loop;

~attack = 2;
~decay = 3;
~envelopeMax = 0.75;

~act = \hold;
