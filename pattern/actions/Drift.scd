// Drift -- the quiet one: a lift you notice a bar after it started.
//
// Everything here is at the slow end -- four-bar attack, sixteen-bar turn,
// a ceiling well under the top. Meant to be held through a whole phrase
// rather than fired at a beat.

~speedLog2 = ~speedLog2 - 1;
~spin = 2;
~swell = 1;
~reach = 0.65;

~attack = 6;
~decay = 6;
~envelopeMax = 0.5;

~freqAttack = 6;
~freqDecay = 6;
~freqMax = 0.4;

~act = \hold;
