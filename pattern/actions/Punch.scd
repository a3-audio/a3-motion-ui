// Punch -- depth and nothing else.
//
// Not one movement value is named, so the clip goes on doing exactly what it
// was doing and only the 3d swells underneath it. This is the action to reach
// for when the trajectory is already right and the moment only needs weight.

~attack = 1;
~decay = 3;
~envelopeMax = 1.0;

~act = \oneshot;
