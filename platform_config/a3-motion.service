[Unit]
Description=A3 Motion User Service

# Part of the rig like everything else. It stood outside the group -- no
# PartOf, no ordering -- which is why it alone could be restarted on its own
# while the others could not. One device, one rule.
PartOf=a3-main.service

# Kept, but it orders against nothing: this is a *user* unit, and there is no
# user-level graphical.target on this machine (`systemctl --user list-units
# --type=target` has none, and graphical-session.target is never reached under
# lightdm+i3 here). What the app actually waits for is in ExecStartPre.
After=graphical.target

[Service]
# The user manager starts the unit before the X session hands DISPLAY over,
# and the screen wait would hang without it (a3nuc1, 2026-09-12; was the
# drop-in display.conf).
Environment=DISPLAY=:0
# The user's data folder, laid out like the checkout: config/ and pattern/.
# '-': on the very first start the seed below makes it.
WorkingDirectory=-%h/.local/share/a3-motion
# As the user, while Motion is stopped: the data folder seeded from
# /usr/share/a3-motion-ui -- copied, never written over (a3-motion-ui-seed).
# '-': a seed that fails must not keep the surface off a set.
ExecStartPre=-/usr/lib/a3-motion-ui/a3-motion-ui-seed %h/.local/share/a3-motion
# The screen being *itself*, not X merely answering -- and not three seconds.
#
# `xset q` answers long before i3 has set the mode: its config turns the output
# off, waits a second and rotates it. The app started in that gap, saw a screen
# of 512x384 at 184 dpi, and JUCE took its display scale from that once and for
# all -- round(184/96) = 2. The whole interface then ran at half size, blown up.
# Measured at the cold start of 2026-09-19; the first line of the app's own log
# says it outright:
#
#   layout: window 1x1+0+0  screen 512x384  dpi 184.2  scale 2.00
#
# Three seconds would not have helped: that start was already 20 seconds after
# boot. So this waits for the quantity that actually decides -- the DPI X
# reports -- and gives up after a minute rather than holding the rig hostage.
ExecStartPre=/usr/lib/a3-motion-ui/a3-wait-for-the-screen
ExecStart=/usr/bin/a3-motion-ui
# A new truth from Core ends Motion with 1 so that it starts again on it
# (a3-system#74). This was the hand-made drop-in restart.conf on a3nuc1 (#69).
Restart=on-failure
RestartSec=5
CPUAffinity=0
# No real-time for the whole process: it would put the GUI above JACK's
# process threads, which made JACK report late clients (2026-10-06).

[Install]
WantedBy=default.target

